        <profile name="Hero of Hades Hive" id="0b4d-08c2-3721-2e4e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll hit rolls of 1 made for friendly ASTRA MILITARUM units within 6&quot; of Commissar Yarrick.  You may re-roll and failed hit rolls for friendly ASTRA MILITARUM units within 6&quot; of Commissar Yarrick when attacking ORK units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Iron Will" id="dede-dba3-fae6-04c1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Roll a D6 each time Commissar Yarrick loses his final wound; on a roll of 3+ that wound is not lost.</characteristic>
          </characteristics>
        </profile>
