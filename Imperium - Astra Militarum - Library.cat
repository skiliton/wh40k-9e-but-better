      <profiles>
        <profile name="Support Vehicle" id="4099-d965-22c9-6bee" hidden="false" page="70" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can repair one friendly ASTRA MILITARUM Vehicle model within 3&quot; of it. That VEHICLE model regains 1 lost wound. Each model can only be repaired once per turn. In addition, if that VEHICLE model has already shot with any weapons that can only be used once per battle, those weapons can be used one additional time this battle.</characteristic>
          </characteristics>
        </profile>
        <profile name="Trojan Support Vehicle" id="654d-743a-2247-e201" hidden="false" page="70" publicationId="7573-8d1b-acdf-2de8" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 6 ASTRA MILITARUM INFANTRY models. Each Heavy Weapon Team or Veteran Heavy Weapon Team model takes the space of 2 models and each OGRYN model takes the space of 3 models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Trojan Support Vehicle [1] (6-10+ wounds remaining)" id="87eb-36f9-d193-c49d" hidden="false" page="70" publicationId="7573-8d1b-acdf-2de8" typeId="800f-21d0-4387-c943" typeName="Unit">
