              <profiles>
                <profile name="Heavy Bombs" id="7d8b-252f-f6e3-acef" hidden="false" page="74" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, if the bearer has any heavy bombs remaining, it can drop one of them. Immediately after the bearer has moved, you can select one point on the battlefield the bearer moved across this phase. Roll one D6 and each unit within 6&quot; of that point, subtracting 1 if that model is a CHARACTER (excluding VEHICLE and MONSTER units): on a 4-5 that unit suffers D3 mortal wounds; on a 6, that unit suffers D6 mortal wounds. Each heavy bomb can only be dropped once per battle.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2x Inferno Bombs" id="8d40-c1f9-41d2-a373" collective="false" hidden="false" import="true" type="upgrade">
