                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Oculus Laureate" id="dc29-c90a-233d-8623" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">OFFICER unit only. In your Command phase, roll one D6 for each unit from your army that has this Campaign Medal and is on the battlefield: if any of those rolls are a 6, you gain 1 Command point.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="The Steel Armorial" id="a7b1-a524-c953-6547" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
