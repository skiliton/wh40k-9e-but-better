      <profiles>
        <profile name="Master Tactician" id="cd3c-5d13-88a9-3013" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, you can select up to three friendly ASTRA MILITARUM units (excluding TITANIC units). Remove these units from the battlefield, then set them up anywhere on the battlefield that is wholly within your deployment zone. If the mission you are playing using the Strategic Reserve rules, you can place any of those units into Strategic Reserves instead.</characteristic>
