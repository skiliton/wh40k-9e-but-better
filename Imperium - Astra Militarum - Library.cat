          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model can transport 12 RENEGADE AND HERETICS INFANTRY models. Each Heavy Weapons Team takes the place of two other models and each OGRYN takes the space of three other models.</characteristic>
          </characteristics>
