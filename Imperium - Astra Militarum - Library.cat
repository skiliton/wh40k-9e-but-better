              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">“When resolving an attack made with a ranged weapon by an INFANTRY model with this doctrine against the closest enemy unit, an unmodified hit roll of 6 scores 1 additional hit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
