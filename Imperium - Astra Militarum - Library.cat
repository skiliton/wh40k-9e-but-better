                        <constraint id="3da9-11fb-d682-e434" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                        <constraint id="3404-581f-455d-07f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <modifiers>
                        <modifier field="hidden" type="set" value="true">
                          <conditions>
                            <condition childId="dd6e-7055-ca6b-b711" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                      <profiles>
                        <profile name="Medal Macharia" id="0ea4-a2ad-e509-0908" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">OFFICER model only. Once per Command phase, when a unit is selected for an Order issued by the bearer, the bearer can use this Relic. If it does so, select one other Order the bearer knows which that unit is eligible to be selected for. That unit is affected by both Orders, even though normally a unit can only be affected by one Order at a time. Note that the second Order issued by the bearer only ever applies to the unit selected for it, even if that unit has the Regimental Tactics ability and every model from your army has the ASTRA MILITARUM keyword.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Moiraean Lance" id="c447-cce4-3cb3-79df" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="0552-a7b0-591a-8b80" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                        <constraint id="de3d-9db9-7c21-db97" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <modifiers>
                        <modifier field="hidden" type="set" value="true">
                          <conditions>
                            <condition childId="83be-1ba9-c326-4760" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                      <profiles>
                        <profile name="Moiraean Lance" id="53ca-24bb-e73f-5028" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12&quot;</characteristic>
                            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistol 1</characteristic>
                            <characteristic name="S" typeId="59b1-319e-ec13-d466">8</characteristic>
                            <characteristic name="AP" typeId="75aa-a838-b675-6484">-3</characteristic>
                            <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                            <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an attack is made with this weapon,if a hit is scored, draw a straight line between the closest part of this model’s base (or hull) and that of the closest model in the target unit. Make one wound roll against the target unit, and each other unit this line passes over. Invulnerable saves cannot be made against attacks made with this weapon.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Star of Terra" id="fc99-4ffe-5e32-6b98" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="2b53-29df-5e5f-5d8b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                        <constraint id="6ad3-e50e-0bb6-ab33" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <modifiers>
                        <modifier field="hidden" type="set" value="true">
                          <conditions>
                            <condition childId="dd6e-7055-ca6b-b711" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                      <profiles>
                        <profile name="Star of Terra" id="f304-76e2-b356-9550" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">OFFICER only. 
-The bearer has a 4+ invulnerable save
-When the bearer first gains this Crusade Relic, select one Warlord Trait for them (this must be a Warlord Trait they can have and that no other model in your Crusade force has). That model gains that Warlord Trait ,even though you did not use the Relic Requisition. Note that this means the bearer can have 2 Warlord Traits
-Once per battle, if the bearer’s unit is selected for an Epic Deed stratagem, that Stratagem costs 0CP.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
