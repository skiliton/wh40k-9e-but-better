                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">CORE unit only. While this unit is within 24&quot; of a friendly COMMANDANT model, it is considered to be within range of that models Senior Officer aura ability</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Merit of the Strategium" id="23d5-90cb-a07b-d149" collective="false" hidden="false" import="true" type="upgrade">
