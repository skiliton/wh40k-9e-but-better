      <profiles>
        <profile name="Find the Best Spot" id="5844-552a-84de-7e0e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, when you set up this unit, it can be set up anywhere on the battlefield that is more than 9&quot; away from the enemy deployment zone and any enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Naturally Stealthy" id="38be-8dbc-3366-a377" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against this unit, subtract 1 from the hit roll. Each time a ranged attack is allocated to a model in this unit while it is receiving the benefits of cover, add an additional 1 to any armour saving throws made against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shoot Sharp and Scarper" id="2e6c-ebba-8ab5-4c32" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One per turn, after this unit has shot, it can make a Normal Move. If it does so after resolving Overwatch, your opponent can select new targets for that charge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
