          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, you receive an additional 2 Command Points if Lord Castellan Creed is your Warlord.</characteristic>
          </characteristics>
        </profile>
      </profiles>
