        <profile name="Transport: Taurox Prime" id="9d9c-c69f-26d4-3cc4" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model can transport 10 MILITARUM TEMPESTUS, OFFICIO PREFECTUS INFANTRY or MILITARUM AUXILLA models (it can only transport MILITARUM AUXILLA models that have been attached to a MILITARUM TEMPESTUS or OFFICIO PREFECTUS unit -- see Regimental Attaches and Bodyguards). Each OGRYN model takes up the space of 3 models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Taurox Prime" id="95d7-cb92-242d-2943" hidden="false" page="125" publicationId="53e9d88f--pubN88319" typeId="800f-21d0-4387-c943" typeName="Unit">
