        <profile name="Stonetooth" id="2830-87a0-bc42-e38d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model would lose a wound, roll a D6: on a 5+ that wound is not lost.</characteristic>
          </characteristics>
        </profile>
