        <profile name="Listen Up, Maggots!" id="5b44-78bd-1fc0-4a94" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You may make one additional order with a single friendly CADIAN OFFICER within 6&quot; of Colour Sergeant Kell in each of your turns.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sworn Protector" id="7315-a452-77e0-5d7f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Roll a D6 each time Lord Castellan Creed loses a wound whilst he is within 3&quot; of Colour Sergeant Kell, on a 2+ Lord Castellan Creed does not lose a wound but Colour Sergeant Kell suffers a mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Colours of the Cadian 8th" id="ec79-a88b-8b5a-b56c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All CADIAN units within 6&quot; of Colour Sergeant Kell may re-roll failed Morale tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
