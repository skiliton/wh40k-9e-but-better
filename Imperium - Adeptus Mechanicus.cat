      <profiles>
        <profile name="Skirmish Optimisation" id="4737-18bf-d199-eefd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an Advance roll is made for this unit, roll one additional D6 and discard one of the dice. Each time this unit is targeted by a weapon with the Blast rule, this unit never counts as containing 6 or more models when determining how many attacks are made with that weapon.</characteristic>
          </characteristics>
