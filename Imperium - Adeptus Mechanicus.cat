      </characteristics>
    </profile>
    <profile name="Arc Lance (shooting)" id="189e-c406-b673-917b" hidden="false" page="93" publicationId="7573-8d1b-acdf-2de8" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
