      <profiles>
        <profile name="Infiltrating Positions" id="975c-b212-50c8-e028" hidden="false" publicationId="ebe8-544e-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, when you set up this unit, it can be set up anywhere on the battlefield that is more than 9&quot; away from the enemy deployment zone and any enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Voices In The Code (Aura)" id="c102-ee77-e7b6-b90f" hidden="false" publicationId="ebe8-544e-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 3&quot; of this unit, subtract 1 from the Leadership characteristic of models in that enemy unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Neurostatic Interference" id="f987-bf83-2b89-0ab1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made against this unit, if the attacking model is within 12&quot;, the hit roll cannot be re-rolled and the wound roll cannot be re-rolled.</characteristic>
          </characteristics>
        </profile>
      </profiles>
