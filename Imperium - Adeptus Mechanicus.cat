            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">8</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">4+</characteristic>
          </characteristics>
        </profile>
        <profile name="Control Edict" id="dd82-68b5-e430-fbab" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly &lt;FORGE WORLD&gt; SKITARII unit within 9&quot; of this model or you can select one friendly &lt;FORGE WORLD&gt; SKITARII DATA-TETHER unit anywhere on the battlefield. Until the start of your next Command phase, that unit ignores the Deprecation effect of the currently active Doctrina Imperative.</characteristic>
          </characteristics>
        </profile>
        <profile name="Servo-skull Uplink" id="c669-9f8b-bc4d-5dc2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;FORGE WORLD&gt; SKITARII CORE unit is within 6&quot; of this model each time a model in that unit makes an attack, re-roll a wound roll of 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="ccec-8d6e-612f-5e7c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="4936-c7d9-d0e0-c23b" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </selectionEntry>
