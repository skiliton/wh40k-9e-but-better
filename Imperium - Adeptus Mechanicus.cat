          <rules>
            <rule name="Purgation Protocols" id="005d-ead8-86b1-b898" hidden="false">
              <description>Each time a CORE model with this dogma makes a ranged attack, on an unmodified wound roll of 6, the Armour Penetration characteristic of that attack is improved by 1.</description>
