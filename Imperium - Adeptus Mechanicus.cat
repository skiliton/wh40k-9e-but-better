      </characteristics>
    </profile>
    <profile name="Kataphron Breacher (indentured)" id="f588-0a2e-5fb3-33a4" hidden="false" publicationId="ebe8-544e-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
