        <profile name="Machine Focus" id="b1c9-e405-874c-dfdd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly &lt;FORGE WORLD&gt; CORE, &lt;FORGE WORLD&gt; KATAPHRON SERVITORS or &lt;FORGE WORLD&gt; SERVITORS unit within 6&quot; of this model. Until the start of your next Command phase:

• If that unit has the KATAPHRON SERVITORS keyword, it can perform actions as if it had the INFANTRY keyword.
• While that unit is performing an action, it can make ranged attacks without that action failing.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Artisans" id="1d35-1c84-9b3d-616e" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="8c3d-f6ab-6cb7-d5cf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="35"/>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <infoGroups>
        <infoGroup name="Fabrications of the Artisan" id="99a5-bac8-7b62-79c2" hidden="false">
          <profiles>
            <profile name="Artisans Initial - Enhanced Biomechanical Interface" id="e92e-317d-ad4d-39dc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, if this part is active for this model, select one friendly &lt;FORGE WORLD&gt; CORE or &lt;FORGE WORLD&gt; KATAPHRON SERVITORS model within 6&quot; of this model. Until the start of your next Movement phase, that unit is eligible to charge and shoot in a turn in which it Fell Back, but if it does so, each time a model in that unit makes a ranged attack, subtract 1 from the attack&apos;s hit roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="Artisans Advanced - Exquisite Calibration" id="b437-bbb7-cf27-8d12" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this part is active for this model, select one friendly &lt;FORGE WORLD&gt; CORE unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes a ranged attack, add 1 to the Strength characteristic of that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <profiles>
        <profile name="Archeotech Modifications" id="d206-564d-6c76-86e3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, if this model is on the battlefield when you use an Adeptus Mechanicus Wargear Stratagem, reduce the CP cost of that Stratagem by 1 CP. Note that the CP Cost is only reduced by 1 CP for that use of the Stratagem, any future usages of it cost the normal amount of CPs.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Logi" id="9232-27a0-b7e5-de60" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="7b93-1c3f-25f3-06f1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="40"/>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="2"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <infoGroups>
        <infoGroup name="Analyses of the Logos" id="7695-d4e6-c905-1049" hidden="false">
          <profiles>
            <profile name="Logi Initial - Predicted Barrage" id="bf6b-1d2c-2655-8e42" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this part is active for this model, select one friendly &lt;FORGE WORLD&gt; CORE unit within 6&quot; of this model. Until the start of your next Command phase, each time an attack with an Armor Penetration characteristic of -1 or -2 is allocated to a model in that unit, that attack has an Armour Penetration characteristic of 0 instead.</characteristic>
              </characteristics>
            </profile>
            <profile name="Logi Advanced - Flaws of the Foe" id="2839-a7cf-7467-7e0e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this part is active for this model, select one friendly &lt;FORGE WORLD&gt; CORE or &lt;FORGE WORLD&gt; KATAPHRON SERVITORS unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes a ranged attack, the target does not receive the benefits of cover against that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <profiles>
        <profile name="Scriptural Prognosis" id="88d2-f21a-1b2c-437f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, if this model is on the battlefield when you use an Adeptus Mechanicus Strategic Ploy Stratagem, reduce the CP cost of that Stratagem by 1 CP. Note that the CP Cost is only reduced by 1 CP for that use of the Stratagem, any future usages of it cost the normal amount of CPs.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Magi" id="1648-6fc5-4051-a3c0" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="96f5-7dac-ee28-3f7a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="30"/>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="2"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <infoGroups>
        <infoGroup name="Scriptural Prognosis" id="cf2b-bc5e-916c-4cd7" hidden="false">
          <profiles>
            <profile name="Magi Initial - Predatory Programming" id="0fa8-98db-9f05-a25a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this part is active for this model, select on friendly &lt;FORGE WORLD&gt; CORE unit within 6&quot; of this model. Until the start of your next Command phase, add 2 to Advance rolls made for that unit.</characteristic>
              </characteristics>
            </profile>
            <profile name="Magi Advanced - Overloaded Safeguards" id="0b88-d97a-d8fe-307c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this part is active for this model, select on friendly &lt;FORGE WORLD&gt; CORE unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes a ranged attack, an unmodified roll of 6 scores 1 additional hit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <profiles>
        <profile name="Aggressive Subroutines" id="7c2c-51d7-8ab0-0732" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, if this model is on the battlefield when you use an Adeptus Mechanicus Epic Deed Stratagem, reduce the CP cost of that Stratagem by 1 CP. Note that the CP Cost is only reduced by 1 CP for that use of the Stratagem, any future usages of it cost the normal amount of CPs.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Genetors" id="1b8a-7bfc-ce01-8097" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="ca8b-b9f8-cce4-0025" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
        <cost name="pts" typeId="points" value="25"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <infoGroups>
        <infoGroup name="Learnings of the Genetor" id="98ab-3834-625d-1a84" hidden="false">
          <profiles>
            <profile name="Genetors Initial - Biochemical Aggression" id="de52-995f-5929-8784" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this part is active for this model, select one friendly &lt;FORGE WORLD&gt; CORE OR &lt;FORGE WORLD&gt; KATAPHRON SERVITORS unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes a melee attack, an unmodified of hit roll 6+ automatically wounds the target.</characteristic>
              </characteristics>
            </profile>
            <profile name="Genetors Advanced - Hypercybernetic Physiology" id="64d0-98b2-55c4-5e3e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this part is active for this model, select one friendly &lt; FORGE WORLD &gt; KAPTAPHRON SERVITORS or &lt; FORGE WORLD &gt; SERVITORS unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit would lose a wound, roll one D6. On a 6, that wound is not lost.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <profiles>
        <profile name="Adaptive Mastery" id="82a5-5dcd-4299-fd2f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, if this model is on the battlefield when you use an Adeptus Mechanicus Battle Tactic Stratagem, reduce the CP cost of that Stratagem by 1 CP. Note that the CP Cost is only reduced by 1 CP for that use of the Stratagem, any future usages of it cost the normal amount of CPs.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Kastelan Phosphor Blaster" id="31d5-4c52-a6b6-c873" collective="false" hidden="false" import="true" type="upgrade">
