        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time the bearer fights, it makes 1 additional attack with this weapon.</characteristic>
      </characteristics>
    </profile>
    <profile name="Transonic Blades" id="fc25-3a36-3321-2d26" hidden="false" publicationId="ebe8-544e-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
