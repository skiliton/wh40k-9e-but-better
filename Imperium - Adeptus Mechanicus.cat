      <profiles>
        <profile name="The Omnissiah&apos;s Hand" id="f8b5-dfce-4a32-73b6" hidden="false" page="55" publicationId="ebe8-544e-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of the Fight phase, you can use this Relic. If you do so, roll one D6 for each enemy unit within 12&quot; of the bearer: on a 2-5, that enemy unit suffers 1 mortal wound; on a 6, that enemy unit suffers D3 mortal wounds.</characteristic>
