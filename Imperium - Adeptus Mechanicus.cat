    <profile name="Arc Lance (melee)" id="be57-e6a0-f90e-eef5" hidden="false" page="93" publicationId="7573-8d1b-acdf-2de8" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
