        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an attack is made with this weapon, an umodified wound roll of 6 inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
      </characteristics>
    </profile>
