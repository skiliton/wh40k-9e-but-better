    <profile name="Kataphron Destroyer (indentured)" id="2934-3d95-75ef-caa3" hidden="false" publicationId="ebe8-544e-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">4+</characteristic>
