                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Acquisitive Reach" id="f41d-5d8f-ee52-c75e" hidden="false">
                  <description>Add 6&quot; to the Range characteristic of rifle and carbine weapons that models with this dogma are equipped with.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
