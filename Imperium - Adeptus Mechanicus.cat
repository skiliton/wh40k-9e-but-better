      <profiles>
        <profile name="Rangers" id="12b5-d074-faae-8ef8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, models in this unit can make a Normal Move up to 3&quot;. They cannot end this move within 9&quot; of enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth Optimisation" id="36c4-b341-eb19-1bc6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against this unit, this unit receives the benefits of Light Cover. If this unit makes a Normal Move, Advances, or Falls Back during your Movement phase, it loses this ability until the start of your next Movement phase.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="7967-3985-9e3c-e265" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
