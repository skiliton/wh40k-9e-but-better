        <profile name="Chaos Land Raider" id="cb04-552b-a6cd-4a76" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 10 &lt;LEGION&gt; INFANTRY models (each TERMINATOR and POSSESSED model takes up the space of two other models. it cannot transport CULT OF DESTRUCTION or JUMP PACK models).</characteristic>
          </characteristics>
        </profile>
