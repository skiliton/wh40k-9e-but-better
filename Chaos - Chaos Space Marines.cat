            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this TRANSPORT model is destroyed, roll one D6 before any embarked models disembark and before removing it from play. On a 6 it explodes, and each unit within 6&quot; suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
