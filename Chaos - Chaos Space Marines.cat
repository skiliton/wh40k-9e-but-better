                        </modifier>
                      </modifiers>
                      <profiles>
                        <profile name="Gurgling Doom" id="b4fe-346d-fb63-2ea4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer fights, before it makes any attacks, select one enemy unit within Engagement Range of the bearer and roll one Dé: on a 2+, that unit suffers D3 mortal wounds. That unit must then take an Out of Action test at the end of the battle, even if it was not destroyed (if it was destroyed, subtract 2 from that Out of Action test).</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
