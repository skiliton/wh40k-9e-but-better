              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit&apos;s TRAITOR ENFORCER model has a 5+ invulnerable save.</characteristic>
              </characteristics>
            </profile>
            <profile name="Forward, for the Dark Gods" id="e272-c0ae-252b-7e8a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, when a friendly TRAITOR GUARDSMAN SQUAD unit within 6&quot; of this unit&apos;s TRAITOR ENFORCER model fails a Morale test, this unit can use this ability. If it does so, until the end of the phase, each time a Combat Attrition test is taken for that TRAITOR GUARDSMAN SQUAD unit, it is automatically passed.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
