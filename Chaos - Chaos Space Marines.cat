              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">8</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Malediction: If manifested, select one enemy unit within 12&quot; of this PSYKER. Until the start of your next Psychic phase, models in that unit cannot use any invulnerable saves.</characteristic>
