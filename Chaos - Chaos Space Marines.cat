      <profiles>
        <profile name="Loyalty&apos;s Reward" id="bac2-54b7-5764-8768" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Select one bolt weapon that the bearer is equipped with.
- That weapon is now a Relic for all rules purposes.
- Each time the bearer makes an attack with that weapon, if the target has the IMPERIUM keyword and a hit is scored, the target suffers one mortal wound and the attack sequence ends.
- Each time the bearer makes an attack with that weapon, if the target does not have the IMPERIUM keyword and that attack successfully wounds the target, the target suffers one mortal wound and the attack sequence ends.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
