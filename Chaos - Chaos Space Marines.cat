      <profiles>
        <profile name="Accursed Horde" id="ccd8-9e23-0952-a40f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot perform actions and cannot embark within TRANSPORT models. At the start of your Command phase, you can select one of the following:
- Return up to 3 destroyed Mutant models to this unit.
- Return one destroyed Torment model to this unit with full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unnatural Regeneration" id="532e-e185-765a-1387" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit would lose a wound, roll one D6: on a 6, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mutant Rabble" id="b0f7-910c-9b0f-c92b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The destruction of Mutant models is ignored for the purposes of Morale tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
