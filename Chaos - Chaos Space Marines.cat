            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <profiles>
            <profile name="Hatred Incarnate" id="e0e6-44e1-80cb-0e08" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD fights, if it made a charge move or performed a Heroic Intervention this turn, until that fight is resolved, add 1 to the Strength and Attacks characteristic of this WARLORD.
- Each time this WARLORD makes a melee attack, you can re-roll that attack&apos;s hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="6. Gaze of the Gods" id="4507-09c1-bbec-4f68" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a5a9-36f2-77d3-810f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="6ed7-3686-33bf-cb7b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
