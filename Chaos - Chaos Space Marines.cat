        <profile name="Lord of the Faithless (Aura)" id="cb29-afcf-81f6-5a81" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ALPHA LEGION unit is within 6&quot; of this model, add 1 to Advance and charge rolls made for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Arch-villain" id="9599-a369-4e87-9430" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, you receive 1 additional Command point if LORD ARKOS is your WARLORD.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrator" id="ff44-fda3-5a2b-6453" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, when you set up this model, it can be set up anywhere on the battlefield that is more than 9&quot; away from the enemy deployment zone and any enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
