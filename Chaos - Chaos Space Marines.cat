        <profile name="Devastating Charge" id="ea86-92a4-ff3a-d1e6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model&apos;s bladed horn weapon has a Strength characteristic of 7 if the bearer made a charge move this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Khorne (Aura)" id="6920-218c-58c9-904f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEGION&gt; KHORNE CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
