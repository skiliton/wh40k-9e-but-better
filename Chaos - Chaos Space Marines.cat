                        <profile name="Flawless Cloak" id="83a8-7f0e-a3cc-cfa9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time an attack is made against the bearer, an unmodified wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have. 
 - Add 3&quot; to the range of all of the bearer’s aura abilities and any ability the bearer uses in your Command phase.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
