            <profile name="Vox Daemonicus" id="fce3-e47f-1347-ff19" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy units that are set up on the battlefield as reinforcements cannot be set up within 12&quot; of the bearer.</characteristic>
              </characteristics>
            </profile>
            <profile name="Vox Daemonicus (Aura)" id="c50d-5363-a7ad-5ce4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy unit attempts to perform an action or psychic action while within 12&quot; of the bearer, roll 2D6. If the result is greater than the enemy unit&apos;s Leadership characteristic, that unit cannot attempt to perform that action or psychic action.</characteristic>
              </characteristics>
            </profile>
          </profiles>
