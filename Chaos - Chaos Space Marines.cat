        <profile name="Mutated Beyond Reason" id="1d6c-d177-7ebb-9e37" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot perform actions. The first time this unit is selected to fight in each Fight phase, roll one D3: until the end of the phase, this unit gains the relevant mutation from the table below.</characteristic>
          </characteristics>
        </profile>
        <profile name="1 - Razor Claws" id="2588-7f59-51a1-dec9" hidden="false" typeId="ab9e-0e23-5699-9d71" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="7911-8c44-6fa5-a910">Change the Armour Penetration characteristic of hideous mutations models in this unit are equipped with to -4.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 - Grasping Pseudopods" id="31a9-7352-70cd-27c2" hidden="false" typeId="ab9e-0e23-5699-9d71" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="7911-8c44-6fa5-a910">Change the Attacks characteristic of models in this unit to 3D3.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 - Toxic Haemorrhage" id="05e4-d9ca-075f-3336" hidden="false" typeId="ab9e-0e23-5699-9d71" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="7911-8c44-6fa5-a910">Each time a model in this unit makes an attack, you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hideous Regeneration" id="481b-2794-4483-3c84" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy unit shoots or fights, after it has finished making its attacks, if any model in this unit lost any wounds as a result of those attacks but was not destroyed, that model immediately regains all of its lost wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
