        <profile name="Haarken Worldclaimer" id="a3f2-51fb-5db2-49a1" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">12&quot;</characteristic>
