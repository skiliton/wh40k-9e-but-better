        <profile name="Lord of Slaanesh (Aura)" id="e3a4-124f-48bd-f320" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEGION&gt; SLAANESH CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
