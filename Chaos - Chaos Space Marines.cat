                      <profiles>
                        <profile name="Book of Fate (Non-Psyker)" id="7ad9-74d1-2373-544c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a non-PSYKER model has this Relic, it gains the PSYKER keyword and can attempt to manifest one psychic power in
your Psychic phase and attempt to deny one psychic power in your opponent&apos;s Psychic phase. It knows Smite, Skeins of Fate and one other power from the Dark Hereticus discipline (pg 118).</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Book of Fate (Non-Psyker)" id="7d6b-c671-70ba-d66c" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
