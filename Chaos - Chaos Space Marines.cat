                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <modifiers>
                        <modifier field="hidden" type="set" value="true">
                          <conditions>
                            <condition childId="34a8-8285-a3c2-f4e6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="lessThan" value="1"/>
