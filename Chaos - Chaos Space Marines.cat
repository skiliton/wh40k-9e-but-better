          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD makes a melee attack, on an unmodified hit roll of 4+, that attack automatically wounds the target and the Armour Penetration characteristic of that attack is improved by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
