            <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Re-roll all failed wound rolls for this weapon when targeting an IMPERIUM unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Cursed Crozius" id="d1c8-a7b5-79d6-8627" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
