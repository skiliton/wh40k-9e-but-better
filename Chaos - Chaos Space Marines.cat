        <profile name="Heldrake 3 (1-3 wounds remaining)" id="f7b9-25a7-5112-f0fd" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">20-30&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">5+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">5+</characteristic>
