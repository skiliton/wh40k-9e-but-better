        <profile name="Lord of Raptors" id="6f94-ae35-f75f-9ab8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly BLACK LEGION CORE or BLACK LEGION CHARACTER unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes an attack, you can re-roll the hit roll (if that unit is a RAPTORS unit, you can also re-roll the wound roll).</characteristic>
          </characteristics>
        </profile>
        <profile name="Herald of the Apocalypse (Aura)" id="be45-45a5-8316-89ee" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this model, each time that unit fails a Morale test, one additional model flees from that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Head Taker" id="8ec5-a908-1d19-58f8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy CHARACTER unit is destroyed by an attack made by this model, until the end of the battle, add 1 to this model’s Attacks characteristic and increase the range of this model&apos;s Herald of the Apocalypse ability by 6&quot; (to a maximum of 24&quot;).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Helspear" id="195e-2f79-42a9-0d1b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
