        <profile name="Explodes (Noctilith Crown)" id="0bf8-37d2-f8f3-0a12" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model is destroyed, roll one D6 before removing it from play. On a 6 it explodes, and each unit within 6&quot; suffers D6 mortal wounds.</characteristic>
          </characteristics>
        </profile>
