          <profiles>
            <profile name="Enhance Warriors (Action)" id="f043-5e7f-a613-7228" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, FABIUS BILE can start to perform this action. If he does so, select one friendly TRAITORIS ASTARTES CORE unit within 3&quot; of FABIUS BILE which does not have the MARK OF CHAOS keyword or an enhancement. This action is completed at the end of your Shooting phase, provided the unit you selected it still within 3&quot; of FABIUS BILE. If completed, roll one D3: until the end of the battle, the unit you selected gains the relevant enhancement from the table below.</characteristic>
              </characteristics>
            </profile>
            <profile name="The Chirurgeon" id="20d7-01d1-3ee9-ed2a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time FABIUS BILE would lose a wound, roll one D6; on a 5+ that wound is not lost. At the start of your Command phase, FABIUS BILE regains up to D3 lost wounds.</characteristic>
              </characteristics>
            </profile>
