      </modifiers>
      <selectionEntries>
        <selectionEntry name="1. Veteran Raider" id="6a45-c052-e2ad-72de" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="26bb-386c-9633-49d8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="a3cd-b7f7-523e-6f84" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Veteran Raider" id="b43c-7565-cc07-ad7a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly BLACK LEGION CORE or BLACK LEGION CHARACTER unit within 6&quot; of this WARLORD. Until the end of the turn, that unit is eligible to shoot and declare a charge in a turn in which it Fell Back.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="2. Indomitable" id="e6cf-bef5-b13c-c442" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0c71-eb36-3f0c-3e85" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="256a-376a-f187-2e07" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Indomitable" id="ff38-caf1-f6ef-0207" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated you to your WARLORD, halve the Damage characteristic of that attack (rounding up).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="4. Soul-eater" id="1584-bdc1-ad4e-a1c5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ef7c-f104-af4c-ec06" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="6c72-8a0b-1bfa-2540" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Soul-eater" id="f026-5a86-808d-e5ae" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD makes a melee attack, you can re-roll the wound roll.
- Each time this WARLORD fights, after it has finished making its attacks, if one or more enemy models were destroyed by those attacks, this WARLORD regains up to D3 lost wounds.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="5. Trusted War-leader" id="e747-a93c-a250-846b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f9b1-ac16-939e-4486" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="307c-59f8-6549-4f02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Trusted War-leader" id="1ac6-735b-afc8-e913" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this WARLORD is on the battlefield, each time you spend a Command Point to use a Stratagem you can roll one D6; on a 5+, that Command Point is refunded.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Warlord Traits (Word Bearers)" id="7ff4-a975-0ecf-2a47" collective="false" hidden="false" import="true">
      <constraints>
