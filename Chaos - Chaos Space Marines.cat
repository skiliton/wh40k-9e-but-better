              <characteristics>
                <characteristic name="Effect" typeId="f486-147a-28c3-ad93">If this prayer is heard, select one friendly &lt;LEGION&gt; CORE, &lt;LEGION&gt; CULTISTS or &lt;LEGION&gt; CHARACTER unit within 6&quot; of this PRIEST. Each time a model in that unit makes a melee attack, add 1 to that attack&apos;s wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
