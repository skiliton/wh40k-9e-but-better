      </modifiers>
      <profiles>
        <profile name="Cypher" id="3e4b-6c49-7abb-954a" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">2+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">2+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">4</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">6</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">6</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">9</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Mysterious Protection" id="9b7e-7032-16a0-4d46" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save. Each time an attack is made against this model, an unmodified hit roll of 1-3 always fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
          </characteristics>
        </profile>
        <profile name="Escape" id="72aa-0673-14f9-b15d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of any Shooting phase or Fight phase, you can remove this model from the battlefield and place it in Strategic Reserves. If the battle ends and this model is not on the battlefield, it is destroyed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Blazing Weapons" id="d5e3-2ebe-5b4d-17c2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to shoot in a turn in which it Fell Back or Advanced.</characteristic>
          </characteristics>
        </profile>
        <profile name="Enigmatic Ally" id="cd7e-55fd-2bf8-6092" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged and a CHAOS SPACE MARINES Detachment in your army contains any CHAOS LORD models, CYPHER can be included in that Detachment without taking up an additional Battlefield Role slot.</characteristic>
          </characteristics>
        </profile>
        <profile name="Agent of Discord" id="50c8-6959-ed5f-c78a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time your opponent uses any rule that allow them to generate Command points or have Command points refunded (excluding the Battleforged CP bonus), roll one D6: on a 4+, your opponent does not gain those Command points or have those Command points refunded.</characteristic>
          </characteristics>
        </profile>
      </profiles>
